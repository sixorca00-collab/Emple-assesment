# Copia este archivo a .env y completa los valores reales. Nunca commitear .env.

# --- PostgreSQL ---
POSTGRES_DB=bd_nombre_apellido_clan
POSTGRES_USER=riwi_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
SERVER_PORT=8080
JWT_SECRET=change-me-min-32-caracteres
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Proveedor de IA (copiloto RAG) ---
AI_PROVIDER=openai
AI_API_KEY=sk-change-me
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend (Angular) ---
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080
