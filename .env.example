# Copia este archivo a .env y completa los valores reales. Nunca commitear .env.

# --- PostgreSQL ---
POSTGRES_DB=bd_nombre_apellido_clan
# superusuario bootstrap: corre migraciones y carga de seed. NO debe llamarse riwi_app.
POSTGRES_USER=riwi_root
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Rol de aplicacion (lo usa el backend; se crea en V2__rls.sql, sin SUPERUSER ni BYPASSRLS) ---
DB_APP_USER=riwi_app
DB_APP_PASSWORD=change-me

# --- Backend (Spring Boot) ---
SERVER_PORT=8080
# minimo 32 caracteres (256 bits) para la firma HS256 del access token
JWT_SECRET=change-me-please-use-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
# origenes del frontend permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Proveedor de IA: chat del copiloto (Groq, compatible con SDK de OpenAI) ---
AI_CHAT_PROVIDER=groq
AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_API_KEY=gsk_change-me
# modelo verificado en console.groq.com/docs/models (ago 2026). Si esta deprecado el dia del demo,
# usar el fallback llama-3.1-8b-instant (limite diario mas alto).
AI_CHAT_MODEL=llama-3.3-70b-versatile

# --- Proveedor de IA: embeddings (Groq no ofrece endpoint de embeddings, se define aparte) ---
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=sk-change-me
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# --- Copiloto RAG ---
COPILOT_TOP_K=6
COPILOT_MIN_SIMILARITY=0.3
# backfill de embeddings al arrancar el backend (en produccion seria asincrono).
# NOTA: docker-compose fuerza ON_STARTUP=true y MODE=all para el servicio backend.
EMBEDDINGS_BACKFILL_ON_STARTUP=false
# missing = solo vectores faltantes; all = re-embebe todo (sobrescribe los sinteticos del seed)
EMBEDDINGS_BACKFILL_MODE=missing

# --- Text search (debe coincidir con el trigger trg_rw_message_search_sync) ---
SEARCH_TEXT_CONFIG=spanish

# --- Frontend (Angular) ---
FRONTEND_PORT=4200
# URL publica del backend para el navegador; debe coincidir con el puerto publicado (SERVER_PORT)
API_BASE_URL=http://localhost:8080
